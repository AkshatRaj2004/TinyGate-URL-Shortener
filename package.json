{
  "name": "tiny-gate",
  "version": "1.0.0",
  "description": "Production-level URL Shortener backend \u2014 Tiny Gate",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "local": "node scripts/local.js",
    "local:stop": "node scripts/local.js --stop",
    "local:seed": "node scripts/seed.js",
    "lint": "eslint . --ext .js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1",
    "morgan": "^1.10.0",
    "nanoid": "^5.0.7",
    "ua-parser-js": "^1.0.38"
  },
  "devDependencies": {
    "nodemon": "^3.1.3"
  },
  "nodemonConfig": {
    "watch": [
      "src",
      "server.js",
      ".env"
    ]
  }
}
